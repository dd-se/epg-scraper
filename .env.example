# Local credentials for live runs — copy to `.env` and fill in:
#
#   cp .env.example .env
#
# `.env` is gitignored and never committed; the values are read only by
# providers that need them (currently `sporekraniapi`, the Spor Ekranı v3
# content API).  Real environment variables always win over this file, so
# GitHub Actions secrets are never overridden.
#
# A different file can be named with the CLI's `--dotenv <path>` flag (Node's
# own `--env-file` is parsed by Node before the script, not by the CLI).
#
# The scheduled workflow does not use this file — it reads the same names from
# repository secrets.
SPOREKRANI_API_APP_ID=
SPOREKRANI_API_KEY=
